# --- secrets ---
.env
*.env

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
.venv/
venv/

# --- runtime data (trajectory/checkpoint/memory) ---
data/*
!data/.gitkeep
.codeagent/          # 运行期记忆（rules/learned.md）与本地 MCP 配置，不进仓库

# --- demo workspace repos (real OSS clones) ---
workspace/*/
!workspace/.gitkeep

# --- editor / os ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- eval 克隆的 OSS 仓库（M5） ---
eval/repos/

# --- 安全机制的真实验证工作区（M7）---
# 里面是真实 LLM 跑出来的轨迹/检查点，以及刻意放置的注入载荷样本与假 .env。
# 它们**故意不进仓库**：载荷样本进仓库会给本项目自己的检测器添一条已知误报，
# 而假 .env 也不该跟着仓库到处走。数字与结论记录在 TASKS.md，工作区本地留档。
m7verify/
m7verify-nolock/
