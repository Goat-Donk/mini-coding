# --- secrets ---
.env
*.env

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# 本机 C: 盘满，跑测试时 --basetemp 指到项目内
#
# 注意：本文件里**不要写行尾注释** —— gitignore 只在行首把 `#` 当注释，写在模式
# 后面的 `# ...` 会成为模式本身的一部分，那条规则就永远不匹配（且不报错）。
# 下面 `.codeagent/` 和 m7verify/ 两处曾因此静默失效。
.pytest_tmp*/
.coverage
htmlcov/
build/
dist/
.venv/
venv/

# --- runtime data (trajectory/checkpoint/memory) ---
data/*
!data/.gitkeep
# 运行期记忆（rules/learned.md）与本地 MCP 配置，不进仓库
.codeagent/

# --- demo workspace repos (real OSS clones) ---
workspace/*/
!workspace/.gitkeep

# --- editor / os ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- eval 克隆的 OSS 仓库（M5） ---
eval/repos/

# --- 安全机制的真实验证工作区（M7）---
# 里面是真实 LLM 跑出来的轨迹/检查点，以及刻意放置的注入载荷样本与假 .env。
# 它们**故意不进仓库**：载荷样本进仓库会给本项目自己的检测器添一条已知误报，
# 而假 .env 也不该跟着仓库到处走。数字与结论记录在 TASKS.md，工作区本地留档。
m7verify/
m7verify-nolock/

# --- M8 四项机制的真实验证工作区 ---
# m8verify/：await_user / skills / plan / 分级截断 A/B 的真实轨迹与检查点。
# 与 m7verify/ 同理不进仓库（真实对话轨迹 + 为制造 token 压力放的样本数据）。
# 数字与结论记录在 TASKS.md 的 P7 小节，工作区本地留档。
m8verify/

# --- M9 向 TS 原版对齐的真实验证工作区 ---
# m9verify/：--review-edits 的真实 CLI 轨迹、检查点，以及 M9-1 的变异测试脚本
# （牙齿检查：逐个打断机制，确认对应测试变红）。与 m7verify/ 同理不进仓库。
m9verify/
